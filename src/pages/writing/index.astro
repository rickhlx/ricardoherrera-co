---
import Writing from "../../layouts/Writing.astro";
import { getPosts, iso, url } from "../../lib/posts.mjs";

const posts = await getPosts();
// Topics, most used first. Only the first few show until the reader asks for the rest.
const counts = new Map<string, number>();
for (const t of posts.flatMap((p) => p.data.tags)) counts.set(t, (counts.get(t) ?? 0) + 1);
const tags = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).map(([t]) => t);
const SHOWN = 6;
const extra = Math.max(0, tags.length - SHOWN);
const byYear = Map.groupBy(posts, (p) => p.data.date.getUTCFullYear());
const site = Astro.site ?? new URL("https://ricardoherrera.co");
const canonical = new URL("writing/", site);
---
<Writing
  title="Writing · Ricardo Herrera"
  description="Notes on site reliability, Kubernetes platforms, observability and infrastructure, written for other engineers by Ricardo Herrera."
  canonical={canonical}
  current="writing"
>
  <div class="index">
    <div class="index-head">
      <span class="eyebrow">Sheet 04 · Revision log</span>
      <h1>Writing</h1>
      <p>Long-form notes on platform engineering, reliability and running infrastructure, plus the occasional detour. Written for other engineers. Every post has a stable link and a change history.</p>
    </div>

    {posts.length > 1 && (
      <div class="filters">
        <div class="search"><label class="sr-only" for="q">Search posts</label><input id="q" type="search" placeholder="Search titles, summaries and topics" autocomplete="off"></div>
        <div class="chips" role="group" aria-label="Filter by topic">
          <button type="button" class="chip" data-tag="" aria-pressed="true">All</button>
          {tags.map((t, i) => <button type="button" class="chip" data-tag={t} aria-pressed="false" hidden={i >= SHOWN} data-more={i >= SHOWN ? "" : undefined}>{t}</button>)}
          {extra > 0 && <button type="button" class="chip chip-toggle" id="moreTags" aria-expanded="false" data-label={`+${extra} more`}>+{extra} more</button>}
        </div>
      </div>
    )}

    <div id="list">
      {posts.length === 0 && <p class="empty">No posts yet.</p>}
      {[...byYear].map(([year, items]) => (
        <section class="year" aria-label={String(year)}>
          <h2>{year}</h2>
          {items.map((p) => (
            <article class="entry" data-tags={JSON.stringify(p.data.tags)} data-text={`${p.data.title} ${p.data.dek} ${p.data.tags.join(" ")}`.toLowerCase()}>
              <div class="when"><b title="Revision">{p.rev}</b><time datetime={iso(p.data.date)}>{iso(p.data.date).slice(5)}</time></div>
              <div class="body">
                <h3><a href={url(`writing/${p.id}/`)}>{p.data.title}</a> {p.data.draft && <span class="draft-badge">Draft</span>}</h3>
                <p>{p.data.dek}</p>
                <div class="meta-line"><span>{p.minutes} min read</span>{p.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
              </div>
            </article>
          ))}
        </section>
      ))}
      <p class="empty" id="noMatch" hidden>No posts match. Try another word or clear the topic filter.</p>
    </div>
  </div>

  <script>
    const q = document.getElementById("q") as HTMLInputElement | null;
    const chips = [...document.querySelectorAll<HTMLButtonElement>(".chip[data-tag]")];
    const more = document.getElementById("moreTags") as HTMLButtonElement | null;
    function showAllTags(open: boolean) {
      document.querySelectorAll<HTMLElement>(".chip[data-more]").forEach((c) => (c.hidden = !open && c.dataset.tag !== tag));
      if (more) {
        more.setAttribute("aria-expanded", String(open));
        more.textContent = open ? "Fewer" : more.dataset.label!;
      }
    }
    more?.addEventListener("click", () => showAllTags(more.getAttribute("aria-expanded") !== "true"));
    let tag = new URLSearchParams(location.search).get("tag") || "";
    function apply() {
      const text = (q?.value || "").trim().toLowerCase();
      let shown = 0;
      document.querySelectorAll<HTMLElement>(".year").forEach((y) => {
        let inYear = 0;
        y.querySelectorAll<HTMLElement>(".entry").forEach((e) => {
          const ok = (!tag || (JSON.parse(e.dataset.tags!) as string[]).includes(tag)) && (!text || e.dataset.text!.includes(text));
          e.hidden = !ok;
          if (ok) inYear++;
        });
        y.hidden = !inYear;
        shown += inYear;
      });
      chips.forEach((c) => c.setAttribute("aria-pressed", String((c.dataset.tag || "") === tag)));
      const none = document.getElementById("noMatch");
      if (none) none.hidden = shown > 0;
    }
    q?.addEventListener("input", apply);
    chips.forEach((c) => c.addEventListener("click", () => {
      tag = c.dataset.tag || "";
      const u = new URL(location.href);
      if (tag) u.searchParams.set("tag", tag); else u.searchParams.delete("tag");
      history.replaceState(null, "", u);
      apply();
    }));
    if (tag) {
      // A link to a topic that's tucked away opens the full list, so the selected chip is visible.
      if (chips.some((c) => c.dataset.tag === tag && c.hasAttribute("data-more"))) showAllTags(true);
      apply();
    }
  </script>
</Writing>
